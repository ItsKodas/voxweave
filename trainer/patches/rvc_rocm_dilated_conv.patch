+def _dilated_conv_by_phase(conv, x, dilation: int):
+    """Run a dilation-1 Conv1d as if it had `dilation`, by convolving each of the
+    `dilation` interleaved phases of x separately. Mathematically identical to a
+    dilated "same" convolution (odd kernel), but avoids the dilated-convolution path,
+    which is ~60x slower on ROCm/MIOpen (Windows, torch 2.9.1+rocm7.2.1)."""
+    if dilation == 1:
+        return conv(x)
+    n, c, l = x.shape
+    pad = (-l) % dilation
+    if pad:
+        x = F.pad(x, (0, pad))
+    lp = (l + pad) // dilation
+    x = x.view(n, c, lp, dilation).permute(0, 3, 1, 2).reshape(n * dilation, c, lp)
+    x = conv(x)
+    x = x.view(n, dilation, -1, lp).permute(0, 2, 3, 1).reshape(n, -1, lp * dilation)
+    return x[..., :l]
+
